# Sed some advanced commands

devuser@KM-PC:~/linux-learning/Day-9$ cat fruit.txt
cat: fruit.txt: No such file or directory
devuser@KM-PC:~/linux-learning/Day-9$ cat > fruit.txt
apple apple banana
banana apple apple
orange apple mango
devuser@KM-PC:~/linux-learning/Day-9$ sed 's/apple/Apple/' fruit.txt
Apple apple banana
banana Apple apple
orange Apple mango
devuser@KM-PC:~/linux-learning/Day-9$ sed 's/apple/Apple/g' fruit.txt
Apple Apple banana
banana Apple Apple
orange Apple mango
devuser@KM-PC:~/linux-learning/Day-9$ sed '2 s/apple/APPLE/g' fruit.txt
apple apple banana
banana APPLE APPLE
orange apple mango
devuser@KM-PC:~/linux-learning/Day-9$ sed -n '2p' fruit.txt
banana apple apple
devuser@KM-PC:~/linux-learning/Day-9$ sed -n '2d' fruit.txt
devuser@KM-PC:~/linux-learning/Day-9$ sed  '2d' fruit.txt
apple apple banana
orange apple mango
